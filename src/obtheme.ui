<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkListStore" id="theme_list_store">
    <columns>
      <column type="gchararray"/> <!-- name -->
      <column type="gchararray"/> <!-- dir -->
    </columns>
  </object>
  <object class="GtkListStore" id="element_list_store">
    <columns>
      <column type="gchararray"/> <!-- key -->
      <column type="gchararray"/> <!-- type -->
    </columns>
  </object>
  <object class="GtkWindow" id="main_window">
    <property name="title">ObTheme</property>
    <property name="default-width">1100</property>
    <property name="default-height">650</property>
    <signal name="destroy" handler="on_main_window_destroy"/>
    <child>
      <object class="GtkPaned" id="theme_paned">
        <property name="visible">True</property>
        <property name="orientation">horizontal</property>
        <property name="position">180</property>
        <child>
          <object class="GtkScrolledWindow">
            <property name="visible">True</property>
            <property name="shadow-type">in</property>
            <child>
              <object class="GtkTreeView" id="theme_list_view">
                <property name="visible">True</property>
                <property name="model">theme_list_store</property>
                <property name="headers-visible">True</property>
                <child internal-child="selection">
                  <object class="GtkTreeSelection" id="theme_list_selection">
                    <property name="mode">single</property>
                    <signal name="changed" handler="on_theme_selection_changed"/>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="theme_name_column">
                    <property name="title">Theme</property>
                    <child>
                      <object class="GtkCellRendererText"/>
                      <attributes>
                        <attribute name="text">0</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkPaned" id="element_paned">
            <property name="visible">True</property>
            <property name="orientation">horizontal</property>
            <property name="position">280</property>
            <child>
              <object class="GtkScrolledWindow">
                <property name="visible">True</property>
                <property name="shadow-type">in</property>
                <child>
                  <object class="GtkTreeView" id="element_list_view">
                    <property name="visible">True</property>
                    <property name="model">element_list_store</property>
                    <property name="headers-visible">True</property>
                    <child internal-child="selection">
                      <object class="GtkTreeSelection" id="element_list_selection">
                        <property name="mode">single</property>
                        <signal name="changed" handler="on_element_selection_changed"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkTreeViewColumn" id="element_key_column">
                        <property name="title">Element</property>
                        <property name="expand">True</property>
                        <child>
                          <object class="GtkCellRendererText"/>
                          <attributes>
                            <attribute name="text">0</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkTreeViewColumn" id="element_type_column">
                        <property name="title">Type</property>
                        <child>
                          <object class="GtkCellRendererText"/>
                          <attributes>
                            <attribute name="text">1</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkPaned" id="detail_paned">
                <property name="visible">True</property>
                <property name="orientation">vertical</property>
                <property name="position">160</property>
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="visible">True</property>
                    <property name="shadow-type">in</property>
                    <child>
                      <object class="GtkViewport">
                        <property name="visible">True</property>
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">vertical</property>
                            <property name="margin">12</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkLabel" id="theme_dir_label">
                                <property name="visible">True</property>
                                <property name="xalign">0</property>
                                <property name="label">No theme selected</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkImage" id="preview_image">
                                <property name="visible">True</property>
                                <property name="xalign">0</property>
                                <property name="yalign">0</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="visible">True</property>
                    <property name="shadow-type">in</property>
                    <child>
                      <object class="GtkViewport">
                        <property name="visible">True</property>
                        <child>
                          <object class="GtkGrid" id="info_grid">
                            <property name="visible">True</property>
                            <property name="margin">12</property>
                            <property name="row-spacing">4</property>
                            <property name="column-spacing">8</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="xalign">0</property>
                                <property name="label">&lt;b&gt;Key:&lt;/b&gt;</property>
                                <property name="use-markup">True</property>
                              </object>
                              <packing>
                                <property name="left-attach">0</property>
                                <property name="top-attach">0</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkLabel" id="info_key_label">
                                <property name="visible">True</property>
                                <property name="xalign">0</property>
                                <property name="selectable">True</property>
                              </object>
                              <packing>
                                <property name="left-attach">1</property>
                                <property name="top-attach">0</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="xalign">0</property>
                                <property name="label">&lt;b&gt;Type:&lt;/b&gt;</property>
                                <property name="use-markup">True</property>
                              </object>
                              <packing>
                                <property name="left-attach">0</property>
                                <property name="top-attach">1</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkLabel" id="info_type_label">
                                <property name="visible">True</property>
                                <property name="xalign">0</property>
                              </object>
                              <packing>
                                <property name="left-attach">1</property>
                                <property name="top-attach">1</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="xalign">0</property>
                                <property name="label">&lt;b&gt;Current value:&lt;/b&gt;</property>
                                <property name="use-markup">True</property>
                              </object>
                              <packing>
                                <property name="left-attach">0</property>
                                <property name="top-attach">2</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkLabel" id="info_value_label">
                                <property name="visible">True</property>
                                <property name="xalign">0</property>
                                <property name="selectable">True</property>
                                <property name="wrap">True</property>
                              </object>
                              <packing>
                                <property name="left-attach">1</property>
                                <property name="top-attach">2</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="xalign">0</property>
                                <property name="label">&lt;b&gt;Default:&lt;/b&gt;</property>
                                <property name="use-markup">True</property>
                              </object>
                              <packing>
                                <property name="left-attach">0</property>
                                <property name="top-attach">3</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkLabel" id="info_default_label">
                                <property name="visible">True</property>
                                <property name="xalign">0</property>
                                <property name="wrap">True</property>
                              </object>
                              <packing>
                                <property name="left-attach">1</property>
                                <property name="top-attach">3</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="xalign">0</property>
                                <property name="yalign">0</property>
                                <property name="label">&lt;b&gt;Description:&lt;/b&gt;</property>
                                <property name="use-markup">True</property>
                              </object>
                              <packing>
                                <property name="left-attach">0</property>
                                <property name="top-attach">4</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkLabel" id="info_desc_label">
                                <property name="visible">True</property>
                                <property name="xalign">0</property>
                                <property name="wrap">True</property>
                                <property name="max-width-chars">60</property>
                              </object>
                              <packing>
                                <property name="left-attach">1</property>
                                <property name="top-attach">4</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="xalign">0</property>
                                <property name="label">&lt;b&gt;See also:&lt;/b&gt;</property>
                                <property name="use-markup">True</property>
                              </object>
                              <packing>
                                <property name="left-attach">0</property>
                                <property name="top-attach">5</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkLabel" id="info_see_also_label">
                                <property name="visible">True</property>
                                <property name="xalign">0</property>
                                <property name="use-markup">True</property>
                                <property name="wrap">True</property>
                                <signal name="activate-link" handler="on_info_see_also_activate_link"/>
                              </object>
                              <packing>
                                <property name="left-attach">1</property>
                                <property name="top-attach">5</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="xalign">0</property>
                                <property name="label">&lt;b&gt;Edit:&lt;/b&gt;</property>
                                <property name="use-markup">True</property>
                              </object>
                              <packing>
                                <property name="left-attach">0</property>
                                <property name="top-attach">6</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkBox" id="edit_box">
                                <property name="visible">True</property>
                                <property name="spacing">6</property>
                                <child>
                                  <object class="GtkColorButton" id="edit_color_button">
                                    <property name="no-show-all">True</property>
                                    <signal name="color-set" handler="on_edit_color_set"/>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSpinButton" id="edit_int_spin">
                                    <property name="no-show-all">True</property>
                                    <property name="numeric">True</property>
                                    <signal name="value-changed" handler="on_edit_int_changed"/>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="edit_reset_button">
                                    <property name="no-show-all">True</property>
                                    <property name="label">Reset to default</property>
                                    <signal name="clicked" handler="on_edit_reset_clicked"/>
                                  </object>
                                </child>
                              </object>
                              <packing>
                                <property name="left-attach">1</property>
                                <property name="top-attach">6</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkGrid" id="texture_edit_grid">
                                <property name="no-show-all">True</property>
                                <property name="row-spacing">4</property>
                                <property name="column-spacing">6</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="xalign">0</property>
                                    <property name="label">Type</property>
                                  </object>
                                  <packing>
                                    <property name="left-attach">0</property>
                                    <property name="top-attach">0</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkComboBoxText" id="texture_type_combo">
                                    <property name="visible">True</property>
                                    <items>
                                      <item id="solid">Solid</item>
                                      <item id="gradient">Gradient</item>
                                      <item id="parentrelative">Parent Relative</item>
                                    </items>
                                    <signal name="changed" handler="on_texture_widget_changed"/>
                                  </object>
                                  <packing>
                                    <property name="left-attach">1</property>
                                    <property name="top-attach">0</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="xalign">0</property>
                                    <property name="label">Direction</property>
                                  </object>
                                  <packing>
                                    <property name="left-attach">0</property>
                                    <property name="top-attach">1</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkComboBoxText" id="texture_direction_combo">
                                    <property name="visible">True</property>
                                    <items>
                                      <item id="horizontal">Horizontal</item>
                                      <item id="vertical">Vertical</item>
                                      <item id="diagonal">Diagonal</item>
                                      <item id="crossdiagonal">Cross Diagonal</item>
                                      <item id="pyramid">Pyramid</item>
                                      <item id="mirrorhorizontal">Mirror Horizontal</item>
                                      <item id="splitvertical">Split Vertical</item>
                                    </items>
                                    <signal name="changed" handler="on_texture_widget_changed"/>
                                  </object>
                                  <packing>
                                    <property name="left-attach">1</property>
                                    <property name="top-attach">1</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="xalign">0</property>
                                    <property name="label">Relief</property>
                                  </object>
                                  <packing>
                                    <property name="left-attach">0</property>
                                    <property name="top-attach">2</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkComboBoxText" id="texture_relief_combo">
                                    <property name="visible">True</property>
                                    <items>
                                      <item id="flat">Flat</item>
                                      <item id="raised">Raised</item>
                                      <item id="sunken">Sunken</item>
                                    </items>
                                    <signal name="changed" handler="on_texture_widget_changed"/>
                                  </object>
                                  <packing>
                                    <property name="left-attach">1</property>
                                    <property name="top-attach">2</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkCheckButton" id="texture_border_check">
                                    <property name="visible">True</property>
                                    <property name="label">Border</property>
                                    <signal name="toggled" handler="on_texture_widget_changed"/>
                                  </object>
                                  <packing>
                                    <property name="left-attach">0</property>
                                    <property name="top-attach">3</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkColorButton" id="texture_border_color_button">
                                    <property name="visible">True</property>
                                    <signal name="color-set" handler="on_texture_widget_changed"/>
                                  </object>
                                  <packing>
                                    <property name="left-attach">1</property>
                                    <property name="top-attach">3</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkComboBoxText" id="texture_bevel_combo">
                                    <property name="visible">True</property>
                                    <items>
                                      <item id="1">Bevel 1</item>
                                      <item id="2">Bevel 2</item>
                                    </items>
                                    <signal name="changed" handler="on_texture_widget_changed"/>
                                  </object>
                                  <packing>
                                    <property name="left-attach">0</property>
                                    <property name="top-attach">4</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkCheckButton" id="texture_interlaced_check">
                                    <property name="visible">True</property>
                                    <property name="label">Interlaced</property>
                                    <signal name="toggled" handler="on_texture_widget_changed"/>
                                  </object>
                                  <packing>
                                    <property name="left-attach">1</property>
                                    <property name="top-attach">4</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="xalign">0</property>
                                    <property name="label">Color / Color To</property>
                                  </object>
                                  <packing>
                                    <property name="left-attach">0</property>
                                    <property name="top-attach">5</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="visible">True</property>
                                    <property name="spacing">6</property>
                                    <child>
                                      <object class="GtkColorButton" id="texture_color1_button">
                                        <property name="visible">True</property>
                                        <signal name="color-set" handler="on_texture_widget_changed"/>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkColorButton" id="texture_color2_button">
                                        <property name="visible">True</property>
                                        <signal name="color-set" handler="on_texture_widget_changed"/>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="texture_reset_button">
                                        <property name="visible">True</property>
                                        <property name="label">Reset to default</property>
                                        <signal name="clicked" handler="on_edit_reset_clicked"/>
                                      </object>
                                    </child>
                                  </object>
                                  <packing>
                                    <property name="left-attach">1</property>
                                    <property name="top-attach">5</property>
                                  </packing>
                                </child>
                              </object>
                              <packing>
                                <property name="left-attach">1</property>
                                <property name="top-attach">7</property>
                              </packing>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
